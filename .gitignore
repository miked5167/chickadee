# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# MCP (Model Context Protocol) configuration
# Contains API tokens and should never be committed
.claude.json
**/mcp.json

# Firecrawl raw web research cache
.firecrawl/

# Local advisor research exports contain public contact data gathered for review.
# Keep them out of this public repository; the site does not read these files.
data/enrichment/

# Unselected logo explorations are local review material, not production assets.
public/logo-concepts-20260822/
nul
